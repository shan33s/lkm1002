# === 測試一 ===
# 使用原始資料：4 人、折價券 100 元
event_name = "  WEEKEND DINNER  "
meal_amount = " NT$1,200 "
people = "4"

service_rate = 0.10
discount = 100
budget_per_person = 300

# 1. 整理聚餐名稱
clean_event_name = event_name.strip().lower()

# 2. 整理餐費並轉換型別
clean_amount = float(meal_amount.replace(" ", "").replace("NT$", "").replace(",", ""))
num_people = int(people)

# 3. 分步計算費用
service_charge = clean_amount * service_rate
total_cost = clean_amount + service_charge - discount
share_per_person = total_cost / num_people

# 4. 判斷是否超過預算
is_over_budget = share_per_person > budget_per_person

# 5. 輸出費用摘要
print("【測試一】")
print(f"聚餐名稱：{clean_event_name}")
print(f"原始餐費：{clean_amount:.2f} 元")
print(f"服務費：{service_charge:.2f} 元")
print(f"折價券：{discount:.2f} 元")
print(f"應付總額：{total_cost:.2f} 元")
print(f"分攤人數：{num_people} 人")
print(f"每人費用：{share_per_person:.2f} 元")
print(f"每人預算：{budget_per_person:.2f} 元")
print(f"是否超過預算：{is_over_budget}")

